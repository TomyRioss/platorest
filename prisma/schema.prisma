generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Tenancy ──────────────────────────────────────────────

model Business {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  logo          String?
  createdAt     DateTime       @default(now())
  restaurants   Restaurant[]
  memberships   Membership[]
  customers     Customer[]
  loyaltyConfig LoyaltyConfig?
  actions       LoyaltyAction[]
  rewards       Reward[]
  socialLinks   SocialLink[]
}

model SocialLink {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  platform   SocialPlatform
  url        String
  sortOrder  Int      @default(0)

  @@unique([businessId, platform])
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  TIKTOK
  X
}

model Restaurant {
  id               String   @id @default(cuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name             String
  slug             String   @unique
  logo             String?
  banner           String?
  address          String?
  lat              Float?
  lng              Float?
  deliveryRadiusKm Float
  createdAt        DateTime @default(now())

  memberships       Membership[]
  suppliers         Supplier[]
  ingredients       Ingredient[]
  purchaseDocuments PurchaseDocument[]
  categories        Category[]
  products          Product[]
  orders            Order[]
  registerSessions  RegisterSession[]
  auditLogs         AuditLog[]
  surveys           Survey[]
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  phone         String?   @unique
  phoneVerified DateTime?
  passwordHash  String?
  name          String
  image         String?
  createdAt     DateTime  @default(now())

  accounts         Account[]
  sessions         Session[]
  memberships      Membership[]
  customers        Customer[]
  ordersCreated    Order[]           @relation("OrderCreatedBy")
  registerSessions RegisterSession[]
  stockMovements   StockMovement[]
  auditLogs        AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Membership {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  businessId   String
  business     Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // null = access to every branch of the business
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  role         Role

  @@unique([userId, businessId, restaurantId])
}

enum Role {
  OWNER
  MANAGER
  CASHIER
  WAITER
}

// ── Inventory ────────────────────────────────────────────

model Supplier {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  contact      String?
  batches      Batch[]
}

model Ingredient {
  id              String     @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name            String
  unit            Unit
  lowStockAlertAt Decimal    @default(0)
  batches         Batch[]
  recipeItems     RecipeItem[]

  @@unique([restaurantId, name])
}

enum Unit {
  G
  ML
  UNIT
}

model PurchaseDocument {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  fileUrl      String
  status       DocumentStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  batches      Batch[]
}

enum DocumentStatus {
  PENDING
  PROCESSED
  FAILED
}

model Batch {
  id           String            @id @default(cuid())
  code         String
  ingredientId String
  ingredient   Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  supplierId   String?
  supplier     Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  documentId   String?
  document     PurchaseDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  unitCost     Decimal
  receivedAt   DateTime          @default(now())
  expiresAt    DateTime?
  movements    StockMovement[]

  @@index([ingredientId, receivedAt])
}

model StockMovement {
  id          String       @id @default(cuid())
  batchId     String
  batch       Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  // signed: purchases positive, sales/waste negative. Batch stock = SUM(qty).
  qty         Decimal
  type        MovementType
  orderItemId String?
  orderItem   OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  reason      String?
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@index([batchId])
  @@index([createdAt])
}

enum MovementType {
  PURCHASE
  SALE
  WASTE
  ADJUSTMENT
  RETURN
}

// ── Menu ─────────────────────────────────────────────────

model Category {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int        @default(0)
  products     Product[]
}

model Product {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name         String
  description  String?
  imageUrl     String?
  gallery      String[]   @default([])
  active       Boolean    @default(true)
  variants     ProductVariant[]
}

model ProductVariant {
  id          String       @id @default(cuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String       @default("Único")
  sku         String?
  price       Decimal
  costPrice   Decimal?
  packagingPrice Decimal?
  isDefault   Boolean      @default(false)
  trackStock  Boolean      @default(false)
  stockQty    Int?
  recipeItems RecipeItem[]
  orderItems  OrderItem[]
}

model RecipeItem {
  id           String         @id @default(cuid())
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  // in the ingredient's base unit
  qty          Decimal

  @@unique([variantId, ingredientId])
}

// ── Orders ───────────────────────────────────────────────

model Order {
  id                String           @id @default(cuid())
  restaurantId      String
  restaurant        Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId        String?
  customer          Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  source            OrderSource
  fulfillment       Fulfillment
  tableNumber       String?
  deliveryAddress   String?
  status            OrderStatus      @default(PENDING)
  paymentMethod     PaymentMethod
  total             Decimal
  createdByUserId   String?
  createdBy         User?            @relation("OrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  registerSessionId String?
  registerSession   RegisterSession? @relation(fields: [registerSessionId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  surveys           Survey[]
  createdAt         DateTime         @default(now())

  @@index([restaurantId, createdAt])
  @@index([createdByUserId, createdAt])
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  unitPrice Decimal
  // snapshot of real batch cost consumed (FIFO) at confirmation time
  unitCost  Decimal        @default(0)
  movements StockMovement[]
}

enum OrderSource {
  POS
  WEB
}

enum Fulfillment {
  PICKUP
  DELIVERY
  DINE_IN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  MERCADOPAGO
}

// ── Register / cashier ───────────────────────────────────

model RegisterSession {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  openedAt     DateTime   @default(now())
  closedAt     DateTime?
  openingCash  Decimal?
  closingCash  Decimal?
  orders       Order[]

  @@index([userId, openedAt])
}

// ── Loyalty (business-level) ─────────────────────────────

model Customer {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name       String
  phone      String?
  email      String?
  createdAt  DateTime @default(now())

  orders            Order[]
  pointsTransactions PointsTransaction[]
  actionCompletions ActionCompletion[]
  redemptions       Redemption[]
  surveys           Survey[]

  @@unique([businessId, phone])
  @@unique([businessId, userId])
}

model LoyaltyConfig {
  id                String   @id @default(cuid())
  businessId        String   @unique
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  pointsPerCurrency Decimal  @default(1)
}

model PointsTransaction {
  id           String      @id @default(cuid())
  customerId   String
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // signed: earn positive, redeem negative. Balance = SUM(points).
  points       Int
  reason       PointsReason
  orderId      String?
  redemptionId String?
  createdAt    DateTime    @default(now())

  @@index([customerId, createdAt])
}

enum PointsReason {
  ORDER
  ACTION
  REDEMPTION
  ADJUSTMENT
}

model LoyaltyAction {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  points      Int
  active      Boolean  @default(true)
  completions ActionCompletion[]
}

model ActionCompletion {
  id         String        @id @default(cuid())
  actionId   String
  action     LoyaltyAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
}

model Reward {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  // one of the two: points-store reward or visit-milestone gift
  pointsCost     Int?
  visitMilestone Int?
  active         Boolean  @default(true)
  redemptions    Redemption[]
}

model Redemption {
  id         String           @id @default(cuid())
  rewardId   String
  reward     Reward           @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  code       String           @unique
  status     RedemptionStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  usedAt     DateTime?
}

enum RedemptionStatus {
  PENDING
  USED
  EXPIRED
}

model Survey {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderId      String?
  order        Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  rating       Int // 1-5
  nps          Int? // 0-10
  comment      String?
  createdAt    DateTime   @default(now())

  @@index([restaurantId, createdAt])
}

// ── Audit ────────────────────────────────────────────────

model AuditLog {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  entityType   String?
  entityId     String?
  payload      Json?
  createdAt    DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([restaurantId, createdAt])
}

// ── Marketing leads (unchanged) ──────────────────────────

model Lead {
  id             String     @id @default(cuid())
  name           String
  email          String
  restaurantName String
  phone          String
  status         LeadStatus @default(NEW)
  notes          String?
  createdAt      DateTime   @default(now())

  @@map("admin_leads")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  REJECTED
  CONVERTED
}
